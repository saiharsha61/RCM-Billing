# =====================================================
# AI-Native RCM Platform - Environment Variables
# =====================================================
# Copy this file to .env and fill in your Supabase credentials
# Found in: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stedi Eligibility API (Phase L)
# Get your free API key at https://www.stedi.com
# 1,000 free eligibility checks/month
VITE_STEDI_API_KEY=your-stedi-api-key-here

# eClinicalWorks FHIR R4 Integration (Phase M)
# Connect to your eCW instance for live patient/appointment data
VITE_ECW_API_URL=https://your-ecw-instance.com/fhir/r4
VITE_ECW_API_KEY=your-ecw-api-key-here

# Plugin Mode (Phase M)
# Set to 'true' to load the focused 2-module SaaS plugin instead of full RCM
VITE_PLUGIN_MODE=false
